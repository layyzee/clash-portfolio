<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="640" height="640">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a3d70" />
      <stop offset="50%" stop-color="#19284d" />
      <stop offset="100%" stop-color="#0f1933" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFE885" />
      <stop offset="40%" stop-color="#F5A623" />
      <stop offset="100%" stop-color="#9C5A08" />
    </linearGradient>
    <filter id="goldShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#050a14" flood-opacity="0.6" />
    </filter>
  </defs>

  <!-- Card Background -->
  <rect width="640" height="640" rx="140" fill="url(#bgGrad)" stroke="#385194" stroke-width="8" />

  <!-- Inner Golden Border -->
  <rect x="36" y="36" width="568" height="568" rx="110" fill="none" stroke="url(#goldGrad)" stroke-width="6" opacity="0.8" />

  <!-- Golden Shield Crest -->
  <g filter="url(#goldShadow)">
    <path d="M 320 110 L 460 160 L 440 370 C 440 440 320 500 320 500 C 320 500 200 440 200 370 L 180 160 Z" fill="#1b2545" stroke="url(#goldGrad)" stroke-width="12" stroke-linejoin="round" />
  </g>

  <!-- Crown / Fortress Citadel Battlements -->
  <g fill="url(#goldGrad)">
    <path d="M 270 190 L 270 230 L 290 230 L 290 200 L 310 200 L 310 230 L 330 230 L 330 200 L 350 200 L 350 230 L 370 230 L 370 190 Z" />
    <!-- Center Jewel -->
    <polygon points="320,165 332,180 320,195 308,180" fill="#62E6FF" stroke="#0F172A" stroke-width="2" />
  </g>

  <!-- Monogram Initials "BP" -->
  <text x="320" y="365" font-family="'Lilita One', 'Cinzel', Impact, sans-serif" font-size="125" font-weight="900" fill="#FFFFFF" text-anchor="middle" stroke="#101933" stroke-width="6" paint-order="stroke fill" filter="url(#goldShadow)">
    BP
  </text>

  <!-- Subtitle Ribbon / Text -->
  <rect x="170" y="405" width="300" height="42" rx="12" fill="#D97706" stroke="#FEF3C7" stroke-width="3" />
  <text x="320" y="433" font-family="'Nunito', sans-serif" font-size="19" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">
    BALAJI PALANI
  </text>

  <!-- Citadel Level Badge -->
  <text x="320" y="480" font-family="'Nunito', sans-serif" font-size="15" font-weight="800" fill="#FDE68A" text-anchor="middle" letter-spacing="1.5">
    CITADEL • LEVEL 7
  </text>
</svg>
